# Copia este archivo como .env y completa los valores (Supabase > Project Settings > API).
# Las variables VITE_ son públicas por diseño; nunca pongas secretos en variables VITE_.
# La seguridad del formulario público la da RLS en la base de datos.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# URL pública del Gateway .NET por Dev Tunnels. Solo para funciones de servidor; nunca uses el prefijo VITE_.
ADMIN_BASE_URL=https://TU-DEV-TUNNEL

# Solo para funciones de servidor en Vercel. Nunca uses el prefijo VITE_.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role
LANDING_API_KEY=define-una-clave-aleatoria-larga
